# Copy to .env and fill in. .env is gitignored - never commit the token.
#
# RUNNER_TOKEN is a *registration* token, not a PAT. Generate it with:
#   gh api -X POST repos/TermeHansen/sendspin-client/actions/runners/registration-token --jq .token
# It is single-use and expires after about an hour.
RUNNER_TOKEN=

# Repository (or organisation) the runner registers against.
RUNNER_REPO_URL=https://github.com/TermeHansen/sendspin-client

# Runner name shown in the GitHub UI. Must be unique per repository.
RUNNER_NAME=osmc-arm64

# Labels the workflows select with `runs-on`. Keep the ARM64 label so
# jobs can distinguish this runner from the x86_64 build host.
RUNNER_LABELS=self-hosted,Linux,ARM64

# Work directory. The host path must equal the container path: workflow
# steps launch nested `docker run -v $GITHUB_WORKSPACE:...` commands that
# the host daemon resolves, so a mismatched path mounts a non-existent dir.
RUNNER_WORKDIR=/srv/sendspin-runner/_work
