+// ============================================================================
+// Liveness watchdog / reconnect
+// ============================================================================
+
+bool ConnectionManager::reap_if_stale(SendspinConnection* conn, int64_t now_us) {
+    // Note: caller must hold conn_ptr_mutex_
+    if (conn == nullptr) {
+        return false;
+    }
+
+    // Only reap established connections. A connection still in the nursery has its own establish
+    // deadline; a pre-establishment peer that goes quiet is handled there and by the transport's
+    // upgrade timeouts.
+    if (!conn->is_handshake_complete()) {
+        return false;
+    }
+
+    // No inbound traffic yet and still no server/hello would be unusual for an established
+    // connection; treat "never received anything since admission" conservatively by skipping the
+    // reap until at least one message has arrived (avoids reacting to a tiny startup window).
+    const int64_t last_inbound = conn->get_last_inbound_time_us();
+    if (last_inbound == 0) {
+        return false;
+    }
+
+    const int64_t timeout_us = this->client_->config_.receive_timeout_ms * US_PER_MS;
+    if (now_us - last_inbound < timeout_us) {
+        return false;
+    }
+
+    const char* kind = conn->is_outbound() ? "outbound" : "inbound";
+    SS_LOGW(TAG, "Connection idle for >%lld ms (%s), treating as dead and dropping",
+            static_cast<long long>(this->client_->config_.receive_timeout_ms), kind);
+
+    // Queue a reconnect for an outbound connection whose target socket went dead, so the manager
+    // re-establishes it with backoff. Inbound connections are left to the discovery flow to
+    // re-admit.
+    if (conn->is_outbound() && !conn->get_target_url().empty()) {
+        this->arm_reconnect(conn->get_target_url());
+    }
+
+    // Tear down via the goodbye path (not a bare nullopt release): drop_connection queues a
+    // DeferredRelease that flush_deferred_releases() performs outside the lock through
+    // disconnect_and_release(), which holds a shared_ptr through the transport stop. That keeps
+    // the object alive while the transport's close callback runs (it calls shared_from_this());
+    // a bare nullopt release would let the destructor stop the half-open transport with the
+    // reference count already at 0 and throw bad_weak_ptr.
+    this->drop_connection(conn, SendspinGoodbyeReason::ANOTHER_SERVER);
+    return true;
+}
+
+void ConnectionManager::arm_reconnect(const std::string& url) {
+    // Note: caller must hold conn_ptr_mutex_
+    if (url.empty()) {
+        return;
+    }
+    for (auto& retry : this->reconnect_retries_) {
+        if (retry.url == url) {
+            // Re-arm in place (a second reap before the first attempt) without resetting the
+            // already-accumulated backoff.
+            retry.next_attempt_us = platform_time_us();
+            return;
+        }
+    }
+    ReconnectState retry;
+    retry.url = url;
+    retry.next_attempt_us = platform_time_us();
+    retry.delay_ms = ReconnectState::INITIAL_RETRY_DELAY_MS;
+    this->reconnect_retries_.push_back(std::move(retry));
+    this->reconnect_pending_.store(true, std::memory_order_release);
+}
+
+void ConnectionManager::on_target_admitted(const std::string& url) {
+    // Note: caller must hold conn_ptr_mutex_
+    if (url.empty()) {
+        return;
+    }
+    for (auto it = this->reconnect_retries_.begin(); it != this->reconnect_retries_.end(); ++it) {
+        if (it->url == url) {
+            this->reconnect_retries_.erase(it);
+            this->reconnect_pending_.store(!this->reconnect_retries_.empty(),
+                                           std::memory_order_release);
+            return;
+        }
+    }
+}
