+
+// Liveness watchdog: an established inbound connection that stops sending messages (a peer that
+// goes quietly offline without closing) must be reaped once it has been silent for
+// receive_timeout_ms. The FakeServer establishes through the hello exchange and then sends nothing
+// further (it only ever responds to client/hello), which exercises exactly the half-open scenario.
+TEST(ConnectionLifecycle, StaleInboundConnectionIsReaped) {
+    SendspinClientConfig config = make_config(STALE_INBOUND_PORT);
+    config.receive_timeout_ms = 1000;  // short for the test
+    TestNetworkProvider network;
+    SendspinClient client(config);
+    client.set_network_provider(&network);
+    ASSERT_TRUE(client.start_server());
+    pump_for(client, 50);
+
+    FakeServer server(server_url(STALE_INBOUND_PORT), "server-stale");
+    EXPECT_TRUE(pump_until(
+        client, [&] { return client.is_connected(); }, 4000));
+    EXPECT_FALSE(server.closed());
+
+    // The connection is now established but the peer sends nothing further; the watchdog must
+    // reap it within roughly receive_timeout_ms (plus margin for the 10ms loop tick).
+    EXPECT_TRUE(pump_until(
+        client, [&] { return !client.is_connected(); }, 5000));
+
+    // The reap drops the connection without a goodbye (the peer is unresponsive, so a goodbye
+    // would not be meaningful); the release closes the local transport. The client must no longer
+    // report the connection as active, and no reconnect is armed for an inbound connection (those
+    // are left to the discovery flow).
+    EXPECT_FALSE(client.is_connected());
+}
+
+// Liveness watchdog with reconnection: an outbound (connect_to) connection that goes silently
+// dead must be reaped and then transparently re-established to the same URL by the manager's
+// reconnect backoff.
+TEST(ConnectionLifecycle, OutboundStaleConnectionReconnects) {
+    // Backend that establishes (answers server/hello) then goes silent.
+    ix::WebSocketServer backend(RECONNECT_PORT, "127.0.0.1");
+    std::atomic<int> hello_count{0};
+    backend.setOnConnectionCallback([&hello_count](const std::weak_ptr<ix::WebSocket>& weak_ws,
+                                                   const std::shared_ptr<ix::ConnectionState>&) {
+        auto ws = weak_ws.lock();
+        if (!ws) {
+            return;
+        }
+        ws->setOnMessageCallback([weak_ws, &hello_count](const ix::WebSocketMessagePtr& msg) {
+            if (msg->type == ix::WebSocketMessageType::Message &&
+                msg->str.find("client/hello") != std::string::npos) {
+                hello_count.fetch_add(1);
+                if (auto locked = weak_ws.lock()) {
+                    locked->send(server_hello_json("server-reconnect", "discovery"));
+                }
+            }
+        });
+    });
+    ASSERT_TRUE(backend.listen().first);
+    backend.start();
+
+    SendspinClientConfig config = make_config(RECONNECT_PORT + 1);
+    config.receive_timeout_ms = 1000;
+    TestNetworkProvider network;
+    SendspinClient client(config);
+    client.set_network_provider(&network);
+    ASSERT_TRUE(client.start_server());
+    pump_for(client, 50);
+
+    client.connect_to(server_url(RECONNECT_PORT));
+    EXPECT_TRUE(pump_until(
+        client, [&] { return client.is_connected(); }, 4000));
+    EXPECT_EQ(hello_count.load(), 1);
+
+    // The backend sends nothing further, so the connection goes quiet; the watchdog must reap it
+    // and then reconnect, re-running the hello handshake (hello_count becomes 2).
+    EXPECT_TRUE(pump_until(
+        client, [&] { return !client.is_connected(); }, 4000));
+    EXPECT_TRUE(pump_until(
+        client, [&] { return client.is_connected() && hello_count.load() >= 2; }, 5000));
+    auto info = client.get_server_information();
+    ASSERT_TRUE(info.has_value());
+    EXPECT_EQ(info->server_id, "server-reconnect");
+
+    client.disconnect(SendspinGoodbyeReason::SHUTDOWN);
+    pump_for(client, 100);
+    backend.stop();
+}
