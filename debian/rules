#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	# Use ARMv6 toolchain for Raspberry Pi 1 builds
	ifneq (,$(filter armv6,$(DEB_HOST_ARCH)))
		TOOLCHAIN_FLAG=-DCMAKE_TOOLCHAIN_FILE=cmake/armv6-toolchain.cmake
	endif
	dh_auto_configure -- \
		-DBUILD_EXAMPLES=OFF \
		-DCMAKE_BUILD_TYPE=Release \
		-DFETCHCONTENT_FULLY_DISCONNECTED=OFF \
		$(TOOLCHAIN_FLAG) \
		$(CMAKEFLAGS)

override_dh_auto_install:
	dh_auto_install
	# Install executable manually
	mkdir -p debian/sendspin-client/usr/bin
	cp obj-$(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)/sendspin-client debian/sendspin-client/usr/bin/
	# Install config files manually
	mkdir -p debian/sendspin-client/etc/sendspin-client
	cp debian/sendspin-client.conf debian/sendspin-client/etc/sendspin-client/
	cp debian/sendspin-client.conf.example debian/sendspin-client/etc/sendspin-client/